def rt (k m : Nat) : Nat := (rtTable.getD k []).getD m 0

/-- The finite check.  For every pair `(k, m)` in range, `N₀ - 2^k - 3^m` is at most `1`, or
has the proper divisor `dv k m`, or `rt k m` squared is congruent to 11 modulo it. -/
theorem key : ∀ k, k < 36 → ∀ m, m < 23 →
    N₀ ≤ 2 ^ k + 3 ^ m + 1 ∨
    (1 < dv k m ∧ dv k m < N₀ - (2 ^ k + 3 ^ m) ∧ (N₀ - (2 ^ k + 3 ^ m)) % dv k m = 0) ∨
    (rt k m * rt k m) % (N₀ - (2 ^ k + 3 ^ m)) = 11 % (N₀ - (2 ^ k + 3 ^ m)) := by
  decide +kernel

/-- `N₀` is not of the form `p + 2^k + 3^m` with `p` prime and 11 a non-residue modulo `p`. -/
theorem not_representable : ¬ Representable N₀ := by
  intro h
  rcases h with ⟨p, k, m, hp, hnr, hN⟩
  have hN₀ : N₀ = 68211369278 := rfl
  have hp2 : 2 ≤ p := hp.1
  have hk : k < 36 := by
    cases Nat.lt_or_ge k 36 with
    | inl h => exact h
    | inr h =>
      have hpow : 2 ^ 36 ≤ 2 ^ k := Nat.pow_le_pow_right (by decide) h
      have hval : (2 : Nat) ^ 36 = 68719476736 := by decide
      omega
  have hm : m < 23 := by
    cases Nat.lt_or_ge m 23 with
    | inl h => exact h
    | inr h =>
      have hpow : 3 ^ 23 ≤ 3 ^ m := Nat.pow_le_pow_right (by decide) h
      have hval : (3 : Nat) ^ 23 = 94143178827 := by decide
      omega
  have hps : N₀ - (2 ^ k + 3 ^ m) = p := by omega
  rcases key k hk m hm with h1 | ⟨hd1, hd2, hd3⟩ | hr
  · omega
  · rw [hps] at hd2 hd3
    have hdvd : dv k m ∣ p := Nat.dvd_of_mod_eq_zero hd3
    cases hp.2 (dv k m) hdvd with
    | inl h => omega
    | inr h => omega
  · rw [hps] at hr
    exact hnr (rt k m) hr

