/-- `p` is prime: `p ≥ 2` and the only divisors of `p` are `1` and `p`. -/
def IsPrime (p : Nat) : Prop := 2 ≤ p ∧ ∀ d : Nat, d ∣ p → d = 1 ∨ d = p

/-- 11 is a quadratic non-residue modulo `p`: no square is congruent to 11 modulo `p`. -/
def NonResidue11 (p : Nat) : Prop := ∀ x : Nat, (x * x) % p ≠ 11 % p

/-- `N = p + 2^k + 3^m` with `p` a prime modulo which 11 is a quadratic non-residue. -/
def Representable (N : Nat) : Prop :=
  ∃ p k m : Nat, IsPrime p ∧ NonResidue11 p ∧ N = p + 2 ^ k + 3 ^ m

